# 复制为 .env 后填写。不要把 .env 提交到仓库。

# 低余额提醒阈值，单位 CNY。
LOW_BALANCE_THRESHOLD_CNY=20

# 重点关注的平台。影响 iOS 主卡片、Widget 的“重点关注”、Mac 状态栏“重点关注”。
# 可选：aliyun, moonshot, deepseek, siliconflow, volcengine, openrouter
PRIMARY_PROVIDER_ID=aliyun

# 网页服务监听地址。iPhone 局域网访问时可设为 0.0.0.0。
HOST=127.0.0.1

# 余额历史。默认每分钟记录一次服务端快照，用于估算按小时消耗。
BALANCE_POLL_ENABLED=true
BALANCE_POLL_INTERVAL_MS=60000
BALANCE_HISTORY_ENABLED=true
BALANCE_HISTORY_RETENTION_DAYS=30
BALANCE_HISTORY_DIR=data

# 请求级 token 用量上报。生产环境建议必须设置强随机 token。
USAGE_EVENTS_ENABLED=true
USAGE_INGEST_TOKEN=
USAGE_EVENTS_RETENTION_DAYS=30
USAGE_EVENTS_DIR=data
USAGE_USER_HASH_SALT=
# 如果浏览器前端跨域上报，可设置为你的业务站点 Origin，例如 https://app.example.com。
USAGE_INGEST_CORS_ORIGIN=

# iPhone 小组件接口保护 token。建议用长随机字符串。
MOBILE_API_TOKEN=

# iPhone App / Widget 读取的摘要接口地址。
# 模拟器可用本机服务地址；真机或公网部署请改为你的局域网/HTTPS 地址。
MOBILE_API_URL=http://127.0.0.1:5173/api/mobile/summary

# Codex / Claude 这类订阅制额度窗口监控，和 API Key 余额是两条线。
# Watch App 读取 summary，本机 CLI/statusline bridge 上报 snapshots。
QUOTA_READ_TOKEN=
QUOTA_INGEST_TOKEN=
QUOTA_API_URL=http://127.0.0.1:5173/api/quota/summary
QUOTA_REFRESH_URL=http://127.0.0.1:5173/api/quota/refresh
QUOTA_INGEST_URL=http://127.0.0.1:5173/api/quota/snapshots
# AI Quota 默认关注服务。可选：codex, codex_proxy, claude
PRIMARY_QUOTA_SERVICE_ID=codex
QUOTA_STALE_SECONDS=120
QUOTA_WARNING_REMAINING_PERCENT=20
QUOTA_CRITICAL_REMAINING_PERCENT=8
QUOTA_RETENTION_DAYS=14
CODEX_QUOTA_REFRESH_MIN_INTERVAL_MS=10000

# Claude claude.ai usage 额度桥接。Cookie 仍放在 macOS 钥匙串，不写入 .env。
# 从 claude.ai usage 请求 URL 中填写 org UUID。
CLAUDE_ORG_UUID=
CLAUDE_KEYRING_SERVICE=token-balance-monitor-claude
CLAUDE_KEYRING_KEY=cookie
CLAUDE_QUOTA_TIMEOUT_MS=30000
CLAUDE_QUOTA_ACCOUNT_LABEL=Claude
CLAUDE_QUOTA_PLAN_LABEL=claude.ai usage

# AI Balance 桌宠默认不混入 AI Quota。如需高级合并显示，可设置：claude / codex / all
PET_QUOTA_REFRESH_SERVICE_ID=

# AI Quota 独立菜单栏入口 quota.command。默认重点关注 PRIMARY_QUOTA_SERVICE_ID。
QUOTA_MENU_SERVICES=claude,codex
QUOTA_MENU_REFRESH_INTERVAL_MS=60000

# Codex 企业代理 / OpenAI-compatible proxy 的 API Key 余额或月度 spend limit。
# 这不是官方 Codex 订阅窗口；它读取你自己的代理服务暴露的余额接口。
# 配好后可设置：PRIMARY_QUOTA_SERVICE_ID=codex_proxy、QUOTA_MENU_SERVICES=claude,codex_proxy。
CODEX_PROXY_BALANCE_URL=
CODEX_PROXY_API_KEY=
CODEX_PROXY_AUTH_HEADER=Authorization
CODEX_PROXY_AUTH_PREFIX=Bearer
CODEX_PROXY_BALANCE_METHOD=GET
CODEX_PROXY_BALANCE_BODY=
CODEX_PROXY_HEADERS_JSON=
CODEX_PROXY_SERVICE_ID=codex_proxy
CODEX_PROXY_SERVICE_NAME=Codex
CODEX_PROXY_ACCOUNT_LABEL=Enterprise proxy
CODEX_PROXY_PLAN_LABEL=API key spend
CODEX_PROXY_CURRENCY=USD
CODEX_PROXY_TIMEOUT_MS=15000
# 如果代理返回字段不标准，可以用逗号分隔 JSON path 显式指定。
# 示例：data.total_used、data.total_granted、data.total_available
CODEX_PROXY_USED_JSON_PATH=
CODEX_PROXY_LIMIT_JSON_PATH=
CODEX_PROXY_REMAINING_JSON_PATH=
CODEX_PROXY_RESETS_AT_JSON_PATH=
# 如果代理返回的是内部额度单位，可以用乘除数转换成真实货币。
CODEX_PROXY_AMOUNT_MULTIPLIER=1
CODEX_PROXY_AMOUNT_DIVISOR=1

# Mac 桌宠/状态栏读取远端 usage 看板的基础地址。留空时会尝试从 MOBILE_API_URL 推断。
# 例如：https://example.com/token-monitor
TOKEN_MONITOR_API_BASE_URL=

# iPhone 侧重点关注提醒阈值，单位 CNY。
MOBILE_ALERT_THRESHOLD_CNY=2

# DeepSeek 开放平台 API Key，用于官方 /user/balance 接口。
DEEPSEEK_API_KEY=

# Kimi / Moonshot 开放平台 API Key，用于官方 /v1/users/me/balance 接口。
MOONSHOT_API_KEY=

# 硅基流动 API Key，用于官方 /v1/user/info 接口。
# 如账号必须走中国大陆旧域名，可设为 https://api.siliconflow.cn。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com

# OpenRouter credits 接口。官方要求使用 Management key。
OPENROUTER_API_KEY=

# 阿里云费用中心 QueryAccountBalance。RAM 用户需要 bss:DescribeAcccount 权限。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 火山引擎费用中心 QueryBalanceAcct。Region 可保持 cn-beijing。
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_REGION=cn-beijing
